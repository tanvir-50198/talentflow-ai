# Copy to .env and change SECRET_KEY before any real deployment
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./talentflow.db
CORS_ORIGINS=http://localhost:5173
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7
MAX_BATCH_FILES=50
MAX_CV_MB=5
# DEBUG=1 returns password-reset links in the API response (development only)
DEBUG=1
